    "status",
    "color",
    "theme",
    "terminal",
    "open"
  ],
  "license": "MIT",
  "homepage": "https://github.com/eriiic7z/pi-cc-header#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/eriiic7z/pi-cc-header.git"
  },
  "files": [
    "extensions/pi-cc-header.ts",
    "quotes.json",
    "README.md",
    "LICENSE"
  ],
  "pi": {
    "extensions": [
      "./extensions"
    ],
